PLATFORM_FEE_BPS=10
REVIEW_WINDOW_HOURS=72
REVISION_LIMIT=2
DISPUTE_EVIDENCE_HOURS=72
API_CREDIT_ON_SELLER_5XX=true
SESSION_SECRET=dev-secret-change-me-min-32-chars-long!!
ADMIN_WALLETS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# false = live on-chain escrow on Arc Testnet (default)
DEMO_MODE=false
CRON_SECRET=dev-cron-secret
